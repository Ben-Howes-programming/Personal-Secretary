# Copy this file to .env and fill in what you use. Never commit .env.

# --- Claude -------------------------------------------------------
# auto        = use your Claude Pro plan through Claude Code if installed, else the API key
# claude_code = Pro plan only        api = API key only
AI_BACKEND=auto
# Only needed for the API route (billed separately from Pro):
ANTHROPIC_API_KEY=

# --- Google (both off by default; the app is read-only without them) ---
# After changing either, delete token.json and press Connect Google in Settings.
ENABLE_GMAIL_DRAFTS=false
ENABLE_CALENDAR_WRITE=false

# --- News ---------------------------------------------------------
# Your personal myFT RSS address (optional)
MYFT_RSS_URL=

# --- Outlook (optional) -------------------------------------------
MS_CLIENT_ID=
MS_TENANT=common

# --- iCloud (optional, use an app-specific password) --------------
ICLOUD_USER=
ICLOUD_APP_PASSWORD=

# --- Voice (optional) ---------------------------------------------
WHISPER_MODEL=base

# --- Cassiopeia ---------------------------------------------------
# Your own mobile number in international form, e.g. +447700900123. Texts only ever go here.
OWNER_PHONE=
ENABLE_IMESSAGE=false
# Emails to your own Gmail address. After turning on, delete token.json and reconnect Google.
ENABLE_EMAIL_TO_SELF=false
# Samples which app is in front once a minute, for the screen-time summary.
ENABLE_ACTIVITY_TRACKING=false
# Hard monthly cap on API-key spending, in pounds.
MONTHLY_API_BUDGET_GBP=10
MORNING_BRIEFING_AT=07:30
EVENING_SUMMARY_AT=21:30
